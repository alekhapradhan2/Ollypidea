# Ollypedia-Backend/.env.example
# Copy this to .env and fill in your values
# NEVER commit the actual .env file to git

MONGO_URI=mongodb+srv://ollipedia:YOUR_PASSWORD@cluster0.XXXXX.mongodb.net/ollipedia?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
PORT=4000
FRONTEND_URL=http://localhost:5173
ADMIN_REGISTER_SECRET=choose_a_secret_word_for_admin_registration

# ── Brevo (Sendinblue) Email Marketing Configuration ──────
# Free 300 emails/day tier: https://app.brevo.com
# For Production / Render (Render blocks SMTP port 587, so REST API on HTTPS 443 is required):
# In Brevo dashboard → SMTP & API → API Keys tab → Generate a new API key (starts with xkeysib-)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# For Local Development via SMTP (optional if BREVO_API_KEY is provided):
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_account_email@domain.com
BREVO_SMTP_KEY=xsmtpsib-your-smtp-master-key-here

BREVO_FROM_EMAIL=noreply@ollypedia.in
BREVO_FROM_NAME=Ollypedia

# Backend URL for unsubscribe + open/click tracking links:
# On Render: automatically defaults to RENDER_EXTERNAL_URL (e.g. https://ollipedia-backend.onrender.com)
# You can also set it explicitly:
BACKEND_URL=https://ollipedia-backend.onrender.com

EMAIL_UNSUBSCRIBE_SECRET=change_me_unsub_secret_min_32_chars
EMAIL_TRACKING_SECRET=change_me_track_secret_min_32_chars
EMAIL_BATCH_SIZE=30
EMAIL_BATCH_DELAY_MS=500
